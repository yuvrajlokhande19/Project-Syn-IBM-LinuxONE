# ==============================================================================
# PROJECT SYN // ENTERPRISE CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your production credentials.
# NOTE: Never commit .env or private cryptographic keys into version control.
# ==============================================================================

# Node Identity & Network Binding
NODE_ID=NODE_1_KEM_HOSPITAL
NODE_LOCATION=Mumbai_Parel_Command_Apex
HOST=0.0.0.0
PORT=8000

# Dual-Mainframe Mesh Peer Configuration
PEER_NODE_URL=http://148.100.98.9:8000
CROSS_NODE_SYNC_INTERVAL_SEC=5

# Cryptographic Hardware Acceleration (IBM Z CPACF)
CPACF_ENABLED=true
HMAC_SECRET_KEY=your_hmac_secret_key_here

# Telegram Emergency Broadcast Dispatcher
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Multi-Cloud AI Cascade Credentials (Optional - Falls back to s390x Air-Gapped Engine)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# CARTO Basemaps API Key (Mumbai GIS)
CARTO_API_KEY=your_carto_api_key_here

# OpenCity.in Mumbai Healthcare CKAN Datastore
OPENCITY_CKAN_URL=https://data.opencity.in/api/action/datastore_search
MUMBAI_HOSPITALS_RESOURCE_ID=8d1c157e-9cee-4bae-a434-f1e6319edf32

# On-Chip Local Model Path (s390x Big-Endian)
LOCAL_MODEL_PATH=/opt/models/granite-4.0-h-350m-base-be.f16.gguf
